# Puerto del servidor
PORT=3000

# Clave secreta para firmar y verificar JWT
JWT_SECRET=bodega_santa_catarina_secret_key_cambiar_en_produccion

# URL de la base de datos MySQL
DATABASE_URL="mysql://usuario:password@localhost:3306/santa_catarina"

# Brevo (Sendinblue) — API Key y configuración del CRM
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID de la lista en Brevo donde guardar los suscriptores (ej: 3)
BREVO_NEWSLETTER_LIST_ID=3
# Remitente verificado en Brevo
BREVO_SENDER_EMAIL=desarrollo@alianzacreativa.es
BREVO_SENDER_NAME="Bodega Santa Catarina"

# Email del propietario/administrador donde recibir alertas de nuevos suscriptores
BREVO_ADMIN_EMAIL=propietario@santacatarina.com

# URL pública del sitio para resolver imágenes/logos en plantillas de email (ej: https://www.bodegasantacatarina.com)
PUBLIC_SITE_URL=http://localhost:3000
